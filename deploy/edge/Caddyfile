# Certificates are issued automatically (DNS of both hosts must point at this VPS).
# flush_interval -1 keeps the SSE stream (/api/analyses/*/events) live through this extra hop.
{$LIVE_HOST} {
	reverse_proxy web-live:80 {
		flush_interval -1
	}
}

{$PREVIEW_HOST} {
	reverse_proxy web-preview:80 {
		flush_interval -1
	}
	# preview = unfinished dev builds: keep it out of search engines
	header X-Robots-Tag "noindex, nofollow"
}
