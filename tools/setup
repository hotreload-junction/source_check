#!/usr/bin/env bash
# One-time setup (team lead, once per repo):  creates `dev`, the board issue (pinned), the label,
# and enables the pre-push guard.  Safe to re-run.
#
# Usage: tools/setup
set -eu
die() { echo "setup: $*" >&2; exit 1; }
command -v gh >/dev/null || die "install gh (https://cli.github.com) and run: gh auth login"
gh auth status >/dev/null 2>&1 || die "run: gh auth login"
cd "$(git rev-parse --show-toplevel)"
git config core.hooksPath .githooks
repo="$(gh repo view --json nameWithOwner --jq .nameWithOwner)"

# dev branch
git fetch -q origin
if ! git show-ref -q --verify refs/remotes/origin/dev; then
  BOARD_ROLE=human git push -q origin "origin/main:refs/heads/dev"; echo "setup: created dev from main"
else echo "setup: dev exists"; fi

# board issue
gh label create board --color 5319e7 --description "agent message board" --force >/dev/null 2>&1 || true
num="$(gh issue list --label board --state open --json number --jq '.[0].number' 2>/dev/null || true)"
if [ -z "$num" ]; then
  body="$(awk '/^---$/ && f<2 {f++; next} f>=2' .github/ISSUE_TEMPLATE/message-board.md)"
  url="$(gh issue create --title "Message Board" --label board --body "$body")"
  num="${url##*/}"; echo "setup: created board issue #$num"
else echo "setup: board issue is #$num"; fi
gh issue pin "$num" >/dev/null 2>&1 || true
gh variable set BOARD_ISSUE --body "$num" >/dev/null 2>&1 || echo "setup: (could not set repo variable BOARD_ISSUE; CI defaults to 1)"

echo
echo "Done. Repo $repo, board #$num."
[ "$num" = 1 ] || echo "Everyone: export BOARD_ISSUE=$num   (put it in your shell rc)"
echo "Each agent: tools/worktree <human>-<role>   e.g. tools/worktree leo-fe"
