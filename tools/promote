#!/usr/bin/env bash
# HUMANS ONLY: promote the current dev to main (main = what the judges see; always demoable).
#   fetch -> main ancestor of dev? -> CI of that dev commit not red? -> tools/check on dev -> fast-forward main -> tag -> board NOTE.
# Rollback: git push origin demo-<tag>:main --force-with-lease   (BOARD_ROLE=human)
#
# Usage: BOARD_ROLE=human tools/promote [--no-check] [--force] ["what is in this demo"]
set -u
die() { echo "promote: $*" >&2; exit 1; }
[ "${BOARD_ROLE:-}" = human ] || die "humans only (set BOARD_ROLE=human). Agents: you ship to dev with tools/ship."
ROOT="$(git rev-parse --show-toplevel)" || die "not in a git repo"; cd "$ROOT"

check=1; force=0
while [ $# -gt 0 ]; do
  case "$1" in
    --no-check) check=0; shift ;;
    --force) force=1; shift ;;
    *) break ;;
  esac
done
note="${*:-}"

git fetch -q origin main dev || die "fetch failed"
git merge-base --is-ancestor origin/main origin/dev \
  || die "main has commits that are not in dev. Merge main into dev first (nobody should commit to main directly)."
[ "$(git rev-parse origin/main)" != "$(git rev-parse origin/dev)" ] || die "main is already at dev"

target="$(git rev-parse origin/dev)"
# CI gate: wait (max 5 min) for the dev-check run of this exact commit; refuse if red (--force overrides)
ci=""
for _ in $(seq 30); do
  ci="$(gh run list --workflow dev-check.yml --commit "$target" --limit 1 --json conclusion,status \
        --jq '.[0] | (.status + "/" + (.conclusion // ""))' 2>/dev/null || true)"
  [ "$ci" = "/" ] && ci=""
  case "$ci" in completed/*) break ;; esac
  [ "$force" = 1 ] && break
  echo "promote: waiting for CI on ${target:0:7} (${ci:-not started}) ..."; sleep 10
done
case "$ci" in
  completed/success) echo "promote: CI green for ${target:0:7}" ;;
  completed/failure|completed/timed_out)
    [ "$force" = 1 ] || die "CI is RED for dev@${target:0:7} (fix dev first, or --force)" ;;
  *) [ "$force" = 1 ] || die "no finished CI run for dev@${target:0:7} after 5 min (${ci:-none}); --force to promote anyway" ;;
esac
if [ "$check" = 1 ]; then
  tmp="$(mktemp -d)"
  git worktree add -q --detach "$tmp" "$target" || die "could not create temp worktree"
  echo "promote: running tools/check on dev@${target:0:7} ..."
  if ! (cd "$tmp" && tools/check); then
    git worktree remove --force "$tmp"; die "dev@${target:0:7} fails tools/check, NOT promoting"
  fi
  git worktree remove --force "$tmp"
fi

git push -q origin "$target:refs/heads/main" || die "push to main failed"
tag="demo-$(LC_ALL=C date +%a-%H%M | tr 'A-Z' 'a-z')"
git tag -f "$tag" "$target" >/dev/null && git push -q -f origin "refs/tags/$tag" || true
echo "promote: main is now ${target:0:7} (tag $tag)"
tools/board post NOTE --to all "main promoted to ${target:0:7} (tag $tag). ${note}" || true
