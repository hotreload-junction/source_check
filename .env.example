# Copy to .env (never commit .env). Secrets are added by humans only.
# Comments stay on their own lines (docker compose env_file and dotenv parse inline comments differently).

# --- LLM: Hostinger AI Router ---
AI_ROUTER_BASE_URL=
AI_ROUTER_API_KEY=
# cheap model (Haiku/mini class) for claim extraction
MODEL_EXTRACT=
# strong model (Sonnet/Opus class); frozen once the eval runs (Q21)
MODEL_VERIFY=
# bump on every prompt change (audit trail)
PROMPT_VERSION=v4

# --- Scraping / search ---
CONTEXT_DEV_API_KEY=
EXA_API_KEY=
FETCH_TIMEOUT_S=20
# Context.dev requests per minute our key allows (raised from 10 to 100 on Nov 14)
CONTEXT_DEV_RPM=100
# Context.dev patience for cited sources (the article itself uses FETCH_TIMEOUT_S)
SOURCE_TIMEOUT_S=12
# resend an LLM request still unanswered after N seconds, first answer wins (0 = off)
LLM_HEDGE_AFTER_S=12

# --- Storage (MariaDB) ---
DATABASE_URL=mysql+pymysql://citetrace:citetrace@localhost:3306/citetrace

# --- Detection: start values from DECISIONS.md; tune only on eval data ---
FUZZY_THRESHOLD=90
MAX_CLAIMS=6
# 2 once depth 2 / citation circles land
MAX_DEPTH=1

# --- Docker (deploy/docker-compose.yml); all optional, defaults work locally ---
# MARIADB_PASSWORD=citetrace
# plain HTTP on :80 inside the container; set a domain on the VPS to get HTTPS automatically
# SITE_ADDRESS=:80
# HTTP_PORT=8080
# HTTPS_PORT=8443
# DB_PORT=3306

# verify Exa candidates that are just other outlets (only adds a corroboration note, costs LLM calls)
VERIFY_SECONDARY=false

# claims still unverified after this many seconds become not_checkable (neutral) instead of stalling the analysis
CLAIM_DEADLINE_S=90

# --- Runtime ---
MAX_CONCURRENT_ANALYSES=2
# e.g. https://citetrace.example.com
PUBLIC_BASE_URL=
