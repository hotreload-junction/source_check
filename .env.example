# Copy to .env (never commit .env). Secrets are added by humans only.
# Comments stay on their own lines (docker compose env_file and dotenv parse inline comments differently).

# --- LLM: Anthropic API (default as soon as the key is set) or the Hostinger AI Router ---
# MODEL_EXTRACT / MODEL_VERIFY are Claude model ids with the Anthropic API (e.g. claude-haiku-5-5, claude-sonnet-5-5)
ANTHROPIC_API_KEY=
# auto = Anthropic when ANTHROPIC_API_KEY is set, else the router; or force anthropic | router
# LLM_PROVIDER=auto
# how hard the model thinks: low | medium | high | xhigh | max (thinking tokens are billed as output)
# LLM_EFFORT=medium
# empty = https://api.anthropic.com
# ANTHROPIC_BASE_URL=
AI_ROUTER_BASE_URL=
AI_ROUTER_API_KEY=
# cheap model (Haiku/mini class) for claim extraction
MODEL_EXTRACT=
# strong model (Sonnet/Opus class); frozen once the eval runs (Q21)
MODEL_VERIFY=
# bump on every prompt change (audit trail)
PROMPT_VERSION=v10

# --- Scraping / search ---
CONTEXT_DEV_API_KEY=
EXA_API_KEY=
FETCH_TIMEOUT_S=20
# Context.dev requests per minute our key allows (raised from 10 to 100 on Nov 14)
CONTEXT_DEV_RPM=100
# Context.dev patience for cited sources (the article itself uses FETCH_TIMEOUT_S)
SOURCE_TIMEOUT_S=12
# resend an LLM request still unanswered after N seconds, first answer wins (0 = off)
LLM_HEDGE_AFTER_S=12

# --- Storage (MariaDB) ---
DATABASE_URL=mysql+pymysql://citetrace:citetrace@localhost:3306/citetrace

# --- Detection: start values from DECISIONS.md; tune only on eval data ---
FUZZY_THRESHOLD=90
MAX_CLAIMS=6
# independent readings for claim selection (majority vote; 5 measured as fully stable)
EXTRACT_VOTES=5
# 3 = follow source citations up to depth 3 (what sources cite, and what those cite; no extra LLM calls) + citation-circle signal
# MAX_DEPTH=3   (default in backend/app/config.py; allowed 1..5; set 1 to switch off, 2 for depth 2. Do not pin it on the VPS)

# --- Docker (deploy/docker-compose.yml); all optional, defaults work locally ---
# MARIADB_PASSWORD=citetrace
# plain HTTP on :80 inside the container; set a domain on the VPS to get HTTPS automatically
# SITE_ADDRESS=:80
# HTTP_PORT=8080
# HTTPS_PORT=8443
# DB_PORT=3306

# verify Exa candidates that are just other outlets (only adds a corroboration note, costs LLM calls)
VERIFY_SECONDARY=false

# claims still unverified after this many seconds become not_checkable (neutral) instead of stalling the analysis
CLAIM_DEADLINE_S=240

# Demo cache dir (cases.json + results/<key>.json) and the eval metrics file; empty = defaults
DEMO_DIR=
METRICS_PATH=

# persistent step cache in MariaDB (LLM answers, fetched pages, Exa results): same article -> same result
STEP_CACHE=true
# hours until a cached step expires (0 = never)
STEP_CACHE_TTL_H=0

# attributed claims without a link: how many found pages to verify / show below the named source
MAX_EVIDENCE_CANDIDATES=5
MAX_EVIDENCE_LINKS=2
# true = independent reports that confirm a quote (but are not the original) make the claim `supported`
CORROBORATION_COUNTS=false

# Exa Agent as extra discovery for claims without a link (paid, ~0.025 USD/run at effort low)
EXA_AGENT=true
EXA_AGENT_EFFORT=low
EXA_AGENT_TIMEOUT_S=80
# Fact-check agent (exa-py SDK, paid: ~0.025 USD/run at low, ~0.10 at medium): ONE run per claim without a usable source
# (unsourced, or attributed with the original not found) looks for pages that CONFIRM or REFUTE it
FACTCHECK_AGENT=true
FACTCHECK_EFFORT=low
FACTCHECK_TIMEOUT_S=80
# claims the article leaves unsourced: still search for a supporting page; one that verifies makes the claim 'supported'
SEARCH_UNSOURCED=true
# a page found for one unsourced claim is also checked against the other unsourced claims
CROSS_CHECK_FOUND=true
# claims without any checkable source: root (own statement / first-hand, neutral) or relay ("doctors claim", unsourced)?
# One MODEL_VERIFY call per such claim, quote-checked against the article (pipeline/origin.py)
ORIGIN_CHECK=true
# follow links to the article's OWN site one step further (source of the source)
FOLLOW_SELF_CITATIONS=true
# claim selection prefers sentences with a source; this many slots stay open for unsourced sentences
MIN_UNSOURCED_CLAIMS=2

# --- Runtime ---
MAX_CONCURRENT_ANALYSES=2
# e.g. https://citetrace.example.com
PUBLIC_BASE_URL=

# Domain reputation badge (PLAN Q2): Wayback Machine first capture per domain (free, no key, step-cached). Context only.
WAYBACK_LOOKUP=true
WAYBACK_TIMEOUT_S=6
# Source of the source without a link ("the New York Times reported"): Exa Agent + searches find that page (~0.025 USD each at effort low)
# CHAIN_SEARCH=true
# MAX_CHAIN_SEARCHES=3
# CHAIN_SEARCH_DEADLINE_S=75
# pages a SEARCH found are read by a cheap model first (same verify prompt); "not_mentioned" ends it there, anything else goes on to MODEL_VERIFY
# empty = claude-haiku-5-5 with the Anthropic API, no screen with the router; SCREEN_CANDIDATES=false = every candidate goes to MODEL_VERIFY
# MODEL_SCREEN=
# SCREEN_CANDIDATES=true
# agent first: our own Exa searches only run when the Exa Agent's pages settle nothing (false = both side by side)
# AGENT_FIRST=true
# model for display-only checks (depth >= 2, source of a source); empty = claude-haiku-5-5 with the Anthropic API, MODEL_VERIFY with the router
# MODEL_CHECK=
